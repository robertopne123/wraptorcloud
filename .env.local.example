# --- Database (Supabase Postgres) ---
# Direct Postgres connection string, used by the app, migrations, and seed script
# (e.g. postgres://postgres:password@db.xxxx.supabase.co:5432/postgres)
DATABASE_URL=

# Reserved for future Supabase-specific features (Storage, Realtime).
# Not required for this stage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS S3 (wired up in this stage, used starting Stage 2) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# --- Seed users (consumed by `npm run db:seed`, not read by the app itself) ---
SEED_USER_1_NAME=Rob
SEED_USER_1_EMAIL=

SEED_USER_2_NAME=Dudley
SEED_USER_2_EMAIL=
